{
  "name": "modern-dotnet-configuration-slides",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export --wait 1500 --timeout 120000",
    "generate": "node build/outline-to-slidev.mjs",
    "export:png": "slidev export --format png --wait 1500 --timeout 120000",
    "export:pptx": "slidev export --format pptx-editable --wait 1500 --timeout 120000"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "latest",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "playwright-chromium": "^1.63.0"
  }
}
